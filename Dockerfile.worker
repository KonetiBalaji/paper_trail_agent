FROM python:3.11-slim-trixie@sha256:6d10e720318bd84cc3d88af92bb5a47189222e17620a2fd214da6445e4afb679
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PAPER_TRAIL_MODE=service \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENCV_FOR_THREADS_NUM=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0t64 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin worker
COPY requirements-lock.txt requirements-ocr-lock.txt requirements-ocr.txt ./
RUN python -m pip install --no-cache-dir -r requirements-ocr.txt && python -m pip check
COPY --chown=10001:10001 app ./app
COPY --chown=10001:10001 data/synthetic ./data/synthetic
COPY --chown=10001:10001 data/ocr ./data/ocr
COPY --chown=10001:10001 scripts/worker_entrypoint.py scripts/container_worker_smoke.py scripts/evaluate_ocr.py scripts/generate_bank_fixtures.py ./scripts/
USER 10001:10001
ENTRYPOINT ["python", "scripts/worker_entrypoint.py"]
CMD ["--poll-seconds", "15"]
