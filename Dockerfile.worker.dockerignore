!data/ocr/
!data/ocr/**
!scripts/
!scripts/worker_entrypoint.py
!scripts/container_worker_smoke.py
!scripts/evaluate_ocr.py
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.key
**/*.pem
