{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app/main.py": { "maxDuration": 300, "excludeFiles": "{tests/**,work/**,storage/**,outputs/**,.venv/**,.git/**}" }
  },
  "daemons": {
    "ocr-worker": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "command": ["python", "scripts/worker_entrypoint.py", "--poll-seconds", "15"],
      "instances": { "iad1": 0 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 120
    }
  }
}
