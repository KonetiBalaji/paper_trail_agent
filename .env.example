# Copy to .env and enter your Meta Model API key locally. Never paste it into chat.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Service mode fails closed unless both database and encryption secrets exist.
# Vercel automatically enables service mode. Never put these values in Git.
PAPER_TRAIL_MODE=local
# DATABASE_URL=postgresql+psycopg://.../database?sslmode=require
# DATA_ENCRYPTION_KEY=<Fernet key generated locally>

# Optional verified USD-per-million token rates; no default price is assumed.
# META_INPUT_USD_PER_MILLION=
# META_OUTPUT_USD_PER_MILLION=
